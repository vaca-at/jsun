/* 통계 */
function solvedCount(ids){ return ids.filter(id=>S.stat[id]).length; }
function rate(ids){ let c=0,t=0; ids.forEach(id=>{const s=S.stat[id]; if(s){c+=s[0];t+=s[0]+s[1];}}); return t?Math.round(c/t*100):0; }
function record(q, ok){
  const s=S.stat[q.id]||[0,0]; s[ok?0:1]++; S.stat[q.id]=s;
  if(ok) delete S.wrong[q.id]; else S.wrong[q.id]=(S.wrong[q.id]||0)+1;
  const d=dayObj(); d.n++; if(ok) d.ok++;
  S.lastSeen=Date.now(); save(); cloudPush();
}

