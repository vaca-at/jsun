function start(kind){
  let pool;
  if(kind==='mix') pool=shuffle(QS).slice(0,10);
  else if(kind==='exam') pool=shuffle(QS).slice(0,60);
  else if(kind==='wrong'){ pool=shuffle(QS.filter(q=>S.wrong[q.id])).slice(0,10); if(!pool.length){ toast('틀린 문제가 없어요. 잘하셨어요!'); return; } }
  else pool=shuffle(QS.filter(q=>q.c===kind)).slice(0,10);
  Q={kind, exam:kind==='exam', list:pool.map(q=>({q, opts:shuffle(q.ch)})), i:0, picks:[], done:false, start:Date.now()};
  view='quiz'; document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('on',b.dataset.go==='quiz'));
  stopTimer();
  if(Q.exam) timerId=setInterval(()=>{ const t=document.getElementById('timer'); if(!t) return; const left=3600-Math.floor((Date.now()-Q.start)/1000); if(left<=0){ finishExam(); return; } t.textContent=fmtLeft(left); },1000);
  drawQ(); window.scrollTo(0,0);
}
const fmtLeft=s=>`${Math.floor(s/60)}분 ${String(s%60).padStart(2,'0')}초`;
const titleOf=()=>Q.exam?'실전 모의시험':Q.kind==='mix'?'섞어서 10문제':Q.kind==='wrong'?'틀린 문제 다시':CATS[Q.kind].name;

function drawQ(){
  if(Q.done){ drawResult(); return; }
  const it=Q.list[Q.i], q=it.q, pick=Q.picks[Q.i], n=Q.list.length;
  const answered = !Q.exam && pick!==undefined;
  const cls=j=>{
    if(Q.exam) return pick===j?'sel':'';
    if(!answered) return '';
    if(it.opts[j]===q.ch[0]) return 'ok';
    return pick===j?'no':'';
  };
  const ok = answered && it.opts[pick]===q.ch[0];
  $v.innerHTML=`
  <section class="card">
    <div class="qhead"><span>${titleOf()}</span><span>${Q.i+1} / ${n}</span>
      ${Q.exam?`<span>남은 시간 <span class="timer" id="timer">${fmtLeft(Math.max(0,3600-Math.floor((Date.now()-Q.start)/1000)))}</span></span>`:''}</div>
    <button class="speak" data-readq="1">🔊 읽기</button>
    <p class="qtext">${esc(q.q)}</p>
    <div class="choices">${it.opts.map((o,j)=>`<button class="ch ${cls(j)}" data-pick="${j}" ${answered?'disabled':''}><b>${NUM[j]}</b><span>${esc(o)}</span></button>`).join('')}</div>
    ${answered?`<div class="result ${ok?'ok':'no'}"><strong>${ok?'⭕ 맞았어요!':'❌ 아쉬워요. 정답은 '+NUM[it.opts.indexOf(q.ch[0])]+' '+esc(q.ch[0])}</strong>${esc(q.ex)}</div>`:''}
    ${!Q.exam && !answered?`<button class="plain" data-skip="1">모르겠어요, 정답 보기</button>`:''}
    ${!Q.exam && answered?`<button class="big" data-next="1">${Q.i+1<n?'다음 문제':'결과 보기'}</button>`:''}
    ${Q.exam?`<div class="row"><button class="plain" data-prev="1" ${Q.i===0?'disabled':''}>이전 문제</button><button class="big" data-next="1">${Q.i+1<n?'다음 문제':'답안 제출하기'}</button></div>
      <details><summary class="sub small" style="cursor:pointer;margin-top:8px">문제 번호로 이동하기</summary>
      <div class="grid-ans">${Q.list.map((_,k)=>`<button class="${Q.picks[k]!==undefined?'done':''} ${k===Q.i?'cur':''}" data-jump="${k}">${k+1}</button>`).join('')}</div></details>`:''}
    <button class="plain" data-quit="1" style="border-style:dashed">그만 풀기</button>
  </section>`;
}
function pickAns(j){
  const it=Q.list[Q.i];
  if(Q.exam){ Q.picks[Q.i]=j; drawQ(); return; }
  if(Q.picks[Q.i]!==undefined) return;
  Q.picks[Q.i]=j; record(it.q, it.opts[j]===it.q.ch[0]); drawQ();
}
function skipAns(){
  const it=Q.list[Q.i];
  Q.picks[Q.i]=-1; record(it.q,false); drawQ();
}
function next(){
  if(Q.exam){
    if(Q.i+1<Q.list.length){ Q.i++; drawQ(); window.scrollTo(0,0); return; }
    const empty=Q.list.filter((_,k)=>Q.picks[k]===undefined).length;
    if(empty && !confirm(`아직 안 푼 문제가 ${empty}개 있어요. 그래도 제출할까요?`)) return;
    finishExam(); return;
  }
  if(Q.picks[Q.i]===undefined) return;
  if(Q.i+1<Q.list.length){ Q.i++; drawQ(); window.scrollTo(0,0); } else { Q.done=true; drawQ(); }
}
function finishExam(){
  stopTimer();
  Q.list.forEach((it,k)=>record(it.q, Q.picks[k]!==undefined && it.opts[Q.picks[k]]===it.q.ch[0]));
  { const n=Q.list.length, c=Q.list.filter((it,k)=>Q.picks[k]!==undefined && it.opts[Q.picks[k]]===it.q.ch[0]).length;
    S.exams.push({at:Date.now(), n, c, score:Math.round(c/n*100), sec:Math.round((Date.now()-Q.start)/1000)}); save(); cloudPush(); }
  Q.done=true; drawQ(); window.scrollTo(0,0);
}
function drawResult(){
  const n=Q.list.length, c=Q.list.filter((it,k)=>Q.picks[k]!==undefined && Q.picks[k]>=0 && it.opts[Q.picks[k]]===it.q.ch[0]).length;
  const score=Math.round(c/n*100), pass=score>=60;
  const wrongs=Q.list.filter((it,k)=>!(Q.picks[k]!==undefined && Q.picks[k]>=0 && it.opts[Q.picks[k]]===it.q.ch[0]));
  $v.innerHTML=`
  <section class="card">
    <h2>${titleOf()} 결과</h2>
    <div class="stats"><div><span class="sub small">맞힌 문제</span><b>${c} / ${n}</b></div><div><span class="sub small">점수</span><b>${score}점</b></div></div>
    <p>${Q.exam?(pass?'🎉 합격 점수(60점)를 넘었어요!':'합격 점수(60점)까지 조금 더 힘내세요.'):(c===n?'🎉 모두 맞혔어요!':'틀린 문제는 "틀린 문제"에 모아 두었어요.')}</p>
    <button class="big" data-again="1">${Q.exam?'모의시험 다시 보기':'10문제 더 풀기'}</button>
    <button class="plain" data-quit="1">문제 고르는 화면으로</button>
  </section>
  ${wrongs.length?`<section class="card"><h2>틀린 문제 다시 보기</h2>${wrongs.map(it=>`<div class="wrongitem"><p><b>${esc(it.q.q)}</b></p><p>정답: <b style="color:var(--ok)">${esc(it.q.ch[0])}</b></p><p class="sub small">${esc(it.q.ex)}</p></div>`).join('')}</section>`:''}`;
}

/* 틀린 문제 노트 */
function wrongNote(){
  const list=QS.filter(q=>S.wrong[q.id]).sort((a,b)=>S.wrong[b.id]-S.wrong[a.id]);
  $v.innerHTML=`
  <section class="card">
    <h2>틀린 문제 ${list.length}개</h2>
    <p class="sub small">많이 틀린 문제가 위에 있어요. 다시 풀어서 맞히면 여기서 빠져요.</p>
    ${list.length?`<button class="big" data-start="wrong">틀린 문제 다시 풀기</button>`:'<p>아직 틀린 문제가 없어요. 문제를 풀어 보세요.</p><button class="big" data-start="mix">오늘의 10문제 풀기</button>'}
    ${list.map(q=>`<div class="wrongitem"><p><b>${esc(q.q)}</b> <span class="sub small">(${S.wrong[q.id]}번 틀림)</span></p>
      <p>정답: <b style="color:var(--ok)">${esc(q.ch[0])}</b></p><p class="sub small">${esc(q.ex)}</p>
      <button class="plain" data-clear="${q.id}" style="min-height:2.4rem;font-size:.85rem">이제 알아요, 목록에서 빼기</button></div>`).join('')}
  </section>
  <p class="center sub small" style="text-align:center"><button class="plain" data-reset="1" style="border-style:dashed;font-size:.8rem;min-height:2.4rem">공부 기록 모두 지우기</button></p>`;
}

/* ───────── 클릭 처리 ───────── */
document.addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b) return;
  const d=b.dataset;
  if(d.size){ S.size=+d.size; save(); applySize(); return; }
  if(d.go){ if(d.go==='quiz' && Q && !Q.done){ view='quiz'; render(); return; } if(d.go==='quiz') Q=null; go(d.go); return; }
  if(d.admin){ go('admin'); return; }
  if(d.apin){ const v=(document.getElementById('apin')||{}).value; if(v===ADMIN_PIN){ admOK=true; adminView(); } else toast('비밀번호가 달라요'); return; }
  if(d.admrefresh){ adminView(); return; }
  if(d.start){ start(d.start); return; }
  if(d.topic!==undefined){ S.topic=+d.topic; save(); study(); window.scrollTo(0,0); return; }
  if(d.golearn){ go('learn'); return; }
  if(d.ltopic!==undefined){ S.topic=+d.ltopic; save(); L=null; learn(); window.scrollTo(0,0); return; }
  if(d.lmode){ S.lmode=d.lmode; save(); L=null; learn(); return; }
  if(d.flip){ L.flipped=!L.flipped; learn(); return; }
  if(d.lres!==undefined){ L.res[L.i]=d.lres==='1'; cardRecord(L.topic, L.res[L.i]); lNext(); return; }
  if(d.lpick!==undefined){ if(L.picked>=0) return; L.picked=+d.lpick; const c=STUDY[L.topic].cards[L.order[L.i]]; L.res[L.i]=L.opts[L.picked]===c.b; cardRecord(L.topic, L.res[L.i]); learn(); return; }
  if(d.lnext){ lNext(); return; }
  if(d.lrestart){ L=null; learn(); return; }
  if(d.lagain){ const again=L.order.filter((_,k)=>L.res[k]!==true); L.order=shuffle(again); L.i=0; L.res=[]; L.done=false; L.flipped=false; if(L.mode==='pick') makeOpts(); learn(); return; }
  if(d.lread){ const c=STUDY[L.topic].cards[L.order[L.i]]; speak(L.mode==='flip'&&!L.flipped ? c.f : c.f+'. '+(L.mode==='pick'&&L.picked<0 ? L.opts.map((o,j)=>NUM[j]+' '+o).join('. ') : c.b+'. '+(c.d||''))); return; }
  if(d.pick!==undefined){ pickAns(+d.pick); return; }
  if(d.skip){ skipAns(); return; }
  if(d.next){ next(); return; }
  if(d.prev){ if(Q.i>0){ Q.i--; drawQ(); } return; }
  if(d.jump!==undefined){ Q.i=+d.jump; drawQ(); return; }
  if(d.again){ start(Q.kind==='wrong'?'wrong':Q.kind); return; }
  if(d.quit){ if(Q && Q.exam && !Q.done && !confirm('모의시험을 그만둘까요? 푼 답은 저장되지 않아요.')) return; stopTimer(); Q=null; go('quiz'); return; }
  if(d.readq){ const it=Q.list[Q.i]; speak(it.q.q+'. '+it.opts.map((o,j)=>NUM[j]+' '+o).join('. ')); return; }
  if(d.read){ const el=document.getElementById(d.read); if(el) speak(el.innerText.replace('🔊 읽기','')); return; }
  if(d.clear){ delete S.wrong[d.clear]; save(); wrongNote(); toast('목록에서 뺐어요'); return; }
  if(d.reset){ if(confirm('푼 기록과 틀린 문제를 모두 지울까요?')){ S.stat={}; S.wrong={}; S.days={}; S.exams=[]; S.cardStat={}; save(); pushNow(); toast('기록을 지웠어요'); go('home'); } return; }
});
document.addEventListener('keydown',e=>{
  if(e.key==='Enter' && e.target.id==='apin'){ const b=document.querySelector('[data-apin]'); if(b) b.click(); return; }
  if(view!=='quiz'||!Q||Q.done) return;
  if(['1','2','3','4'].includes(e.key)) pickAns(+e.key-1);
  if(e.key==='Enter') next();
});
if('speechSynthesis' in window) speechSynthesis.getVoices();

let lastAct=Date.now();
['click','keydown','touchstart'].forEach(ev=>document.addEventListener(ev,()=>{ lastAct=Date.now(); },{passive:true}));
setInterval(()=>{
  if(document.visibilityState==='visible' && Date.now()-lastAct<120000 && view!=='admin'){
    dayObj().min++; S.lastSeen=Date.now(); save(); cloudPush();
  }
},60000);

applySize();
render();
cloudPull().then(r=>{ if(r){ mergeRemote(r); if(view==='home') render(); } if(FIREBASE_CONFIG) pushNow(); });
</script>
</body>
</html>
