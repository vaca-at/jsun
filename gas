/* 날짜별 기록: { n 푼 문제, ok 맞힌 문제, cards 카드 본 수, min 공부한 분 } */
(function migrate(){
  const nd={};
  Object.entries(S.days||{}).forEach(([k,v])=>{
    const [y,m,d]=k.split('-').map(Number); const key=y+'-'+pad(m)+'-'+pad(d);
    nd[key]= typeof v==='number' ? {n:v,ok:0,cards:0,min:0} : Object.assign({n:0,ok:0,cards:0,min:0},v);
  });
  S.days=nd; S.exams=S.exams||[]; S.cardStat=S.cardStat||{};
})();
