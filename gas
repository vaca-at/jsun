/* ───────── 온라인 기록 (Firebase) ───────── */
const cloud={ready:null, db:null, ok:false};
function cloudInit(){
  if(!FIREBASE_CONFIG) return Promise.resolve(null);
  if(cloud.ready) return cloud.ready;
  const load=src=>new Promise((res,rej)=>{const t=document.createElement('script');t.src=src;t.onload=res;t.onerror=rej;document.head.appendChild(t);});
  const base='https://www.gstatic.com/firebasejs/10.12.2/';
  cloud.ready=load(base+'firebase-app-compat.js').then(()=>load(base+'firebase-firestore-compat.js')).then(()=>{
    firebase.initializeApp(FIREBASE_CONFIG); cloud.db=firebase.firestore(); cloud.ok=true; return cloud.db;
  }).catch(e=>{console.warn('온라인 기록 연결 실패',e); return null;});
  return cloud.ready;
}
const docRef=()=>cloud.db.collection('gas').doc(LEARNER_ID);
async function cloudPull(){
  if(!await cloudInit()) return null;
  try{ const snap=await docRef().get(); return snap.exists?snap.data():null; }catch(e){ console.warn('불러오기 실패',e); return null; }
}
function mergeRemote(r){
  if(!r) return;
  const localEmpty=!Object.keys(S.stat).length;
  Object.entries(r.stat||{}).forEach(([id,v])=>{ const l=S.stat[id]||[0,0]; S.stat[id]=[Math.max(l[0],v[0]||0),Math.max(l[1],v[1]||0)]; });
  if(localEmpty) S.wrong=Object.assign({},r.wrong||{});
  Object.entries(r.days||{}).forEach(([k,v])=>{ const l=dayObj(k); ['n','ok','cards','min'].forEach(f=>{ l[f]=Math.max(l[f]||0,v[f]||0); }); });
  const seen=new Set(S.exams.map(x=>x.at)); (r.exams||[]).forEach(x=>{ if(!seen.has(x.at)) S.exams.push(x); }); S.exams.sort((a,b)=>a.at-b.at);
  Object.entries(r.cardStat||{}).forEach(([t,v])=>{ const l=S.cardStat[t]||{k:0,a:0}; S.cardStat[t]={k:Math.max(l.k,v.k||0),a:Math.max(l.a,v.a||0)}; });
  save();
}
function totals(st=S.stat){ let c=0,w=0; Object.values(st).forEach(v=>{c+=v[0];w+=v[1];}); return {c,w,n:c+w}; }
let pushT=null;
function cloudPush(){ if(!FIREBASE_CONFIG) return; clearTimeout(pushT); pushT=setTimeout(pushNow,2000); }
async function pushNow(){
  if(!await cloudInit()) return;
  const t=totals();
  try{
    await docRef().set({name:LEARNER_NAME, updatedAt:Date.now(), lastSeen:S.lastSeen||Date.now(), solved:t.n, correct:t.c,
      stat:S.stat, wrong:S.wrong, days:S.days, exams:S.exams.slice(-40), cardStat:S.cardStat});
  }catch(e){ console.warn('저장 실패',e); }
}

/* 읽어 주기 */
function speak(text){
  if(!('speechSynthesis' in window)){ toast('이 기기는 읽어 주기를 지원하지 않아요'); return; }
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text.replace(/[①②③④]/g,m=>({'①':'1번','②':'2번','③':'3번','④':'4번'}[m])).replace(/~/g,'에서').replace(/℃/g,'도').replace(/÷/g,'나누기').replace(/×/g,'곱하기'));
  u.lang='ko-KR'; u.rate=0.85;
  const v=speechSynthesis.getVoices().find(v=>(v.lang||'').replace('_','-').startsWith('ko')); if(v) u.voice=v;
  speechSynthesis.speak(u);
}

