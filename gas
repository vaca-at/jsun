function cardRecord(topic, ok){
  const c=S.cardStat[topic]||{k:0,a:0}; ok?c.k++:c.a++; S.cardStat[topic]=c;
  dayObj().cards++; S.lastSeen=Date.now(); save(); cloudPush();
}
let L=null;
function newL(){
  const cards=STUDY[S.topic].cards;
  L={topic:S.topic, mode:S.lmode, order:shuffle(cards.map((_,k)=>k)), i:0, flipped:false, res:[], picked:-1, opts:null, done:false};
  if(L.mode==='pick') makeOpts();
}
function makeOpts(){
  const cards=STUDY[L.topic].cards, c=cards[L.order[L.i]];
  const others=shuffle(cards.filter(x=>x.b!==c.b).map(x=>x.b)).slice(0,3);
  L.opts=shuffle([c.b,...others]); L.picked=-1;
}
function learn(){
  if(!L || L.topic!==S.topic || L.mode!==S.lmode) newL();
  const cards=STUDY[L.topic].cards, n=L.order.length;
  const head = topicTabs('ltopic') + `<div class="modes">
      <button class="${S.lmode==='flip'?'on':''}" data-lmode="flip">🃏 뒤집기 카드</button>
      <button class="${S.lmode==='pick'?'on':''}" data-lmode="pick">👆 골라 맞히기</button></div>`;
  const dots = `<div class="dots2" aria-hidden="true">${L.order.map((_,k)=>`<i class="${L.res[k]===true?'k':L.res[k]===false?'a':''} ${k===L.i&&!L.done?'c':''}"></i>`).join('')}</div>`;
  if(L.done){
    const k=L.res.filter(x=>x===true).length, a=n-k;
    $v.innerHTML = head + `<section class="card" style="text-align:center">
      <h2>${STUDY[L.topic].t} 다 봤어요!</h2>${dots}
      <div class="stats" style="justify-content:center"><div><span class="sub small">알아요</span><b style="color:var(--ok)">${k}개</b></div><div><span class="sub small">다시 볼 것</span><b style="color:var(--no)">${a}개</b></div></div>
      ${a?`<button class="big" data-lagain="1">다시 볼 것 ${a}개만 한 번 더</button>`:'<p>🎉 모두 알고 있어요!</p>'}
      <div class="navrow"><button class="plain" data-lrestart="1">처음부터 다시</button><button class="plain" data-ltopic="${(L.topic+1)%STUDY.length}">다음 주제 ▶</button></div>
      <button class="plain" data-start="mix">문제 풀기로 가기</button></section>`;
    return;
  }
  const c=cards[L.order[L.i]];
  if(L.mode==='flip'){
    $v.innerHTML = head + `<section class="card">
      <div class="qhead"><span>${STUDY[L.topic].t}</span><span>${L.i+1} / ${n}</span></div>${dots}
      <button class="flip ${L.flipped?'on':''}" data-flip="1" aria-label="카드 뒤집기">
        <div class="flip-in">
          <div class="face front"><div class="fq">${c.f}</div><div class="hint2">👆 눌러서 답 보기</div></div>
          <div class="face back">${c.v||''}<div class="fa">${c.b}</div>${c.d?`<div class="fd">${c.d}</div>`:''}</div>
        </div>
      </button>
      <button class="speak" style="float:none;margin:8px auto 0;display:block" data-lread="1">🔊 읽기</button>
      ${L.flipped?`<div class="cardnav"><button class="plain again" data-lres="0">다시 볼래요</button><button class="big" style="margin:10px 0" data-lres="1">알아요 👍</button></div>`
                 :`<button class="plain" data-flip="1">답 보기</button>`}
    </section>`;
  } else {
    const ans=c.b, done=L.picked>=0;
    $v.innerHTML = head + `<section class="card">
      <div class="qhead"><span>${STUDY[L.topic].t}</span><span>${L.i+1} / ${n}</span></div>${dots}
      <div class="pickq">${L.topic===0?c.v:''}<div class="fq">${c.f}</div></div>
      <button class="speak" style="float:none;margin:0 auto 10px;display:block" data-lread="1">🔊 읽기</button>
      <div class="choices">${L.opts.map((o,j)=>`<button class="ch ${done?(o===ans?'ok':j===L.picked?'no':''):''}" data-lpick="${j}" ${done?'disabled':''}><b>${NUM[j]}</b><span>${esc(o)}</span></button>`).join('')}</div>
      ${done?`<div class="result ${L.opts[L.picked]===ans?'ok':'no'}"><strong class="pop">${L.opts[L.picked]===ans?'⭕ 맞았어요!':'❌ 정답은 '+esc(ans)}</strong>${c.d||''}</div>
        <button class="big" data-lnext="1">${L.i+1<n?'다음':'결과 보기'}</button>`:''}
    </section>`;
  }
}
function lNext(){
  L.i++; L.flipped=false;
  if(L.i>=L.order.length){ L.done=true; }
  else if(L.mode==='pick') makeOpts();
  learn(); window.scrollTo(0,0);
}

