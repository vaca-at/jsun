// 가족 초대장 (jsun.site/70th) 사진 · 글 저장 규칙 — Firebase 프로젝트 moon-15f88
// Firebase 콘솔 → moon-15f88 → Storage → 규칙 탭에 이 파일 전체를 붙여 넣고 [게시]
// 관리자: 공부방과 같은 구글 계정 (메일 주소는 SHA-256 값으로만 적어 둬요)
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
           == '22fa372a479af0929cadcbf6b12b6c2dace34800344067ef44b21a0c187487fb';
    }

    // 사진: 누구나 보기, 올리기 · 지우기는 관리자만 (한 장 8MB 미만, 덮어쓰기 없음)
    match /70th/photos/{file} {
      allow get: if true;
      allow create: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
      allow list, update: if false;
    }

    // 초대장 글 (window.INVITE_DATA = {...}): 누구나 보기, 고치기는 관리자만
    match /70th/invite.js {
      allow get: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 512 * 1024
        && request.resource.contentType == 'text/javascript';
      allow delete: if isAdmin();
    }

    // 그 밖의 곳은 모두 막아 둬요
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
